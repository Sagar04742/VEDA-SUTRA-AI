{
  "name": "vedic-chatbot",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm test -w server",
    "build": "npm run build -w client",
    "ingest": "npm run ingest -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
