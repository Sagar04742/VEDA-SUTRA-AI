{
  "name": "vedic-chatbot",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm run build && npm start -w server",
    "test": "npm test -w server",
    "build": "npm run build -w client",
    "ingest": "npm run ingest -w server",
    "check:live": "npm run check:live -w server",
    "eval": "npm run eval -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
