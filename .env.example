# --- Server ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vedic-chatbot
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# --- Gemini (main chat) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Mistral (chat titles) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=

# --- Chat memory: how many recent messages are sent to Gemini ---
CHAT_HISTORY_LIMIT=20
