# Copy to server/.env and fill in. Nothing here is hardcoded in the code.

# --- Server ---
# The API port. The web app port is taken from CLIENT_URL below (both are read by the dev servers).
PORT=11111
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vedic-chatbot
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:8888

# --- Gemini (main chat, tool calling, streaming) ---
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional second model used automatically when the main one is rate limited (free-tier quotas are per model).
GEMINI_FALLBACK_MODEL=
# The model picker offers three levels. GEMINI_MODEL is "Sutra Lite" (quick, short answers, the default).
# Optional: a better model for "Sutra Plus" and the best one for "Sutra Pro". A level left empty uses the one below it.
# If a level's model is busy or at its free limit, the answer automatically comes from the next model down.
GEMINI_MODEL_PLUS=
GEMINI_MODEL_PRO=

# --- Mistral (chat titles) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=

# --- Chat memory: how many recent messages are sent to Gemini with each question ---
CHAT_HISTORY_LIMIT=20

# --- Optional ---
# Force DNS servers if an Atlas (mongodb+srv) URL fails with querySrv ECONNREFUSED. (The app already retries with public DNS.)
# DNS_SERVERS=1.1.1.1,8.8.8.8
# Cookie SameSite: lax (default; client and API on one origin), or none for a separately hosted client.
# COOKIE_SAMESITE=lax
# Requests per window per IP. Defaults: 30 auth requests / 15 min, 60 chat requests / min.
# AUTH_RATE_LIMIT=30
# CHAT_RATE_LIMIT=60
# DEV ONLY: use a built-in stand-in instead of Gemini/Mistral so the app runs without API keys.
# It is not an AI: it assembles answers from the solver and knowledge base. Never set in production.
# AI_MOCK=1
