# Copy to server/.env and fill in. Nothing here is hardcoded in the code.

# --- Server ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vedic-chatbot
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# --- Gemini (main chat, tool calling, streaming) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Mistral (chat titles) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=

# --- Chat memory: how many recent messages are sent to Gemini with each question ---
CHAT_HISTORY_LIMIT=20

# --- Optional ---
# Requests per window per IP. Defaults: 30 auth requests / 15 min, 60 chat requests / min.
# AUTH_RATE_LIMIT=30
# CHAT_RATE_LIMIT=60
# DEV ONLY: use a built-in stand-in instead of Gemini/Mistral so the app runs without API keys.
# It is not an AI: it assembles answers from the solver and knowledge base. Never set in production.
# AI_MOCK=1
